fn main() {
    println("sqrt(0)   = {sqrt(0.0)}");
    println("sqrt(4)   = {sqrt(4.0)}");
    println("sqrt(9)   = {sqrt(9.0)}");
    println("sqrt(2)   = {sqrt(2.0)}");
    println("exp(0)    = {exp(0.0)}");
    println("exp(1)    = {exp(1.0)}");
    println("tanh(0)   = {tanh(0.0)}");
    println("tanh(1)   = {tanh(1.0)}");
    println("erf(0)    = {erf(0.0)}");
    println("erf(1)    = {erf(1.0)}");
}
